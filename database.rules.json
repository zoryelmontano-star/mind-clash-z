{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostId').val() === auth.uid && newData.child('state/phase').val() === 'lobby'",
        "state": {
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (root.child('rooms').child($code).child('hostId').val() === auth.uid || (auth.uid === $uid && root.child('rooms').child($code).child('state/phase').val() === 'lobby'))"
          }
        },
        "answers": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($code).child('state/phase').val() === 'question' && root.child('rooms').child($code).child('players').child(auth.uid).exists() && now < root.child('rooms').child($code).child('state/deadline').val()",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            }
          }
        }
      }
    }
  }
}